# ==============================================================================
# FitTrack Environment Configuration (.env.example)
# Copy this file to .env for local overrides, or set these in Render Dashboard
# ==============================================================================

# Database Connection URL:
# - Local Development: sqlite:///./fittrack.db
# - Production (Neon PostgreSQL): postgresql://user:password@ep-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./fittrack.db

# Environment & Server
# Set to 'production' for live deployments (enforces strict security checks)
# Set to 'development' for local coding and testing
ENVIRONMENT=development
PORT=8000

# Security & JWT Token Secrets (Generate 256-bit key via: openssl rand -hex 32)
# CRITICAL: In production (ENVIRONMENT=production), SECRET_KEY must be a unique, secure string >= 32 chars
SECRET_KEY=replace_with_a_secure_random_32_character_string_for_production
JWT_SECRET_KEY=replace_with_a_secure_random_32_character_string_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
# Comma-separated list of origins (e.g., https://fittrack.onrender.com,http://localhost:8000) or * for open development
CORS_ORIGINS=*

# Optional External API Integrations (Application runs with offline fallbacks if empty)
USDA_API_KEY=
AI_API_KEY=
